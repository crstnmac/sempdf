  "compilerOptions": {
    "sourceMap": false,
    "declarationMap": false,
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/components/**",
    "src/routes/**",
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "src/start.ts",
