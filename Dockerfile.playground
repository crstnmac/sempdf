# Playground: static HTML/JS + built lib served from repo root by server.mjs.
# Multi-stage: install/build in a throwaway stage, ship only the built app.
FROM node:24-alpine AS build
WORKDIR /app
# The registry token is a BuildKit build secret. Dokploy exposes it under the
# env/secret name NPM_TOKEN -> /run/secrets/NPM_TOKEN. The repo `.npmrc` is
# gitignored (never in the build context), so the registry config + token are
# written inline for the `npm ci` layer only, then removed.
COPY package*.json ./
RUN --mount=type=secret,id=NPM_TOKEN \
    printf 'registry=https://npm.sempdf.net\n@sempdf:registry=https://npm.sempdf.net\n//npm.sempdf.net/:_authToken=%s\n' "$(cat /run/secrets/NPM_TOKEN)" > .npmrc \
 && npm ci \
 && rm -f .npmrc
COPY . .
# Builds dist/src/** which the page importmap + type fetches resolve against.
RUN npm run build

# Final image carries only the built app — no token in its history.
FROM node:24-alpine
WORKDIR /app
COPY --from=build /app .
ENV PORT=4173
EXPOSE 4173
CMD ["node", "examples/website/server.mjs"]
