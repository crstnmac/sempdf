{
  "name": "@crstnmac/sempdf-mcp",
  "version": "0.6.0",
  "description": "Model Context Protocol server exposing @crstnmac/sempdf PDF generation and manipulation as tools.",
  "type": "module",
  "bin": {
    "sempdf-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "bundle": "node scripts/build-mcpb.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://nodeproxy.criston.dev/"
  },
  "dependencies": {
    "@crstnmac/sempdf": "^1.9.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.1.0",
    "@types/node": "^25.6.0",
    "esbuild": "^0.24.0",
    "typescript": "^6.0.2"
  }
}
