{
  "name": "@zeropdf/zeropdf-pdf",
  "version": "1.7.1",
  "description": "Zero-dependency PDF generation engine built in TypeScript.",
  "type": "module",
  "author": {
    "name": "Criston Mascarenhas",
    "email": "criston2011@gmail.com"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./chrome-extension-fonts": {
      "types": "./dist/src/chrome-extension-fonts.d.ts",
      "import": "./dist/src/chrome-extension-fonts.js"
    },
    "./woff2": {
      "types": "./dist/src/woff2.d.ts",
      "import": "./dist/src/woff2.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json",
    "docs": "npm run docs:build",
    "docs:api": "rm -rf docs/api && typedoc",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:dev": "npm run docs:api && vitepress dev docs --host 0.0.0.0",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:performance": "npm run build && node --test dist/test/performance.test.js",
    "test:stress": "npm run build && node --test dist/test/stress.test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test && npm run build:lib",
    "typecheck": "tsc --noEmit",
    "validate:pdf": "node scripts/validate-verapdf.mjs",
    "visual:render": "npm run build && node scripts/render-visual-fixtures.mjs",
    "visual:compare": "npm run build && node scripts/compare-visual-fixtures.mjs",
    "visual:update": "npm run build && node scripts/compare-visual-fixtures.mjs --update",
    "visual:preview": "npm run build && node examples/visual-preview/server.mjs",
    "example:hello": "npm run build && node dist/examples/hello-world.js",
    "example:image": "npm run build && node dist/examples/jpeg-image.js",
    "example:png": "npm run build && node dist/examples/png-image.js",
    "example:tagged": "npm run build && node dist/examples/tagged-pdf.js",
    "example:report": "npm run build && node dist/examples/tagged-pdf-report.js",
    "example:pdf2-encryption": "npm run build && node dist/examples/pdf2-encryption.js",
    "example:pdf2-tagged": "npm run build && node dist/examples/pdf2-tagged.js",
    "example:pdf-version": "npm run build && node dist/examples/pdf-version-autodetect.js",
    "example:cookbook-invoice": "npm run build && node dist/examples/cookbook-invoice.js",
    "example:cookbook-ticket": "npm run build && node dist/examples/cookbook-ticket.js",
    "example:cookbook-certificate": "npm run build && node dist/examples/cookbook-certificate.js",
    "example:cookbook-report": "npm run build && node dist/examples/cookbook-multi-column-report.js",
    "example:cookbook-sign": "npm run build && node dist/examples/cookbook-sign-existing-pdf.js",
    "example:template-forms": "npm run build && node dist/examples/template-forms.js",
    "example:template-annotations": "npm run build && node dist/examples/template-annotations.js",
    "example:template-graphics": "npm run build && node dist/examples/template-graphics.js",
    "example:template-custom": "npm run build && node dist/examples/template-custom.js",
    "example:web": "npm run build && node examples/website/server.mjs",
    "example:json": "npm run build && node dist/examples/json-to-pdf.js",
    "example:rich-text": "npm run build && node dist/examples/rich-text.js"
  },
  "keywords": [
    "pdf",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^25.6.0",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.3",
    "pdfkit": "^0.18.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.13.1"
  }
}
