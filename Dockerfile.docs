# VitePress docs → static, served by nginx.
FROM node:22-alpine AS build
# git: VitePress `lastUpdated` runs `git log` per page.
RUN apk add --no-cache git
WORKDIR /app
# The registry token is a BuildKit build secret. Dokploy exposes it under the
# env/secret name NPM_TOKEN -> /run/secrets/NPM_TOKEN. .npmrc holds the private
# registry; the token is appended only for the `npm ci` layer and never persisted.
COPY package*.json .npmrc ./
RUN --mount=type=secret,id=NPM_TOKEN \
    printf '//npm.barrierbreak.net/:_authToken=%s\n' "$(cat /run/secrets/NPM_TOKEN)" >> .npmrc \
 && npm ci \
 && rm -f .npmrc
COPY . .
# docs:build = typedoc (docs/api) + vitepress build → docs/.vitepress/dist
RUN npm run docs:build

FROM nginx:alpine
# apache2-utils: htpasswd, used by the entrypoint to build the Basic Auth file from env.
RUN apk add --no-cache apache2-utils
COPY --from=build /app/docs/.vitepress/dist /usr/share/nginx/html
# cleanUrls: true needs a $uri.html fallback; default conf 404s on /guide/x.
COPY nginx.docs.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.docs.sh /docker-entrypoint.docs.sh
RUN chmod +x /docker-entrypoint.docs.sh
EXPOSE 80
# Generates /etc/nginx/auth.conf from DOCS_PASSWORD, then runs nginx in foreground.
CMD ["/docker-entrypoint.docs.sh"]
