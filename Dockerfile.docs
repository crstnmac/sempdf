# VitePress docs → static, served by nginx.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# docs:build = typedoc (docs/api) + vitepress build → docs/.vitepress/dist
RUN npm run docs:build

FROM nginx:alpine
COPY --from=build /app/docs/.vitepress/dist /usr/share/nginx/html
EXPOSE 80
