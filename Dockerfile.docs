FROM node:24-alpine AS build
WORKDIR /app
# The registry token is a BuildKit build secret. Dokploy exposes it under the
# env/secret name NPM_TOKEN -> /run/secrets/NPM_TOKEN. The repo `.npmrc` is
# gitignored (never in the build context), so the registry config + token are
# written inline for the `npm ci` layer only, then removed.
COPY package*.json ./
RUN --mount=type=secret,id=NPM_TOKEN \
    printf 'registry=https://nodeproxy.criston.dev\n' > .npmrc \
 && printf '@crstnmac:registry=https://nodeproxy.criston.dev\n' >> .npmrc \
 && printf '//nodeproxy.criston.dev/:_authToken=%s\n' "$(cat /run/secrets/NPM_TOKEN)" >> .npmrc \
 && npm ci --ignore-scripts \
 && rm -f .npmrc
COPY . .
# docs:build = TypeDoc API Markdown + the Fumadocs/TanStack Start app.
RUN npm run docs:build

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=80
COPY --from=build /app/.output ./.output
EXPOSE 80
CMD ["node", ".output/server/index.mjs"]
