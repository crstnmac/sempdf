# Envsubst template — ${API_UPSTREAM} is replaced at container start
# (default http://api:8787, see web.Dockerfile).

server {
    listen       80;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Security headers for the SPA. `always` so they are sent on error responses
    # too. CSP is the main XSS defense-in-depth: everything loads from 'self',
    # the API is same-origin (connect-src 'self'), and framing is forbidden.
    # style-src allows 'unsafe-inline' because React inline styles + the charting
    # component emit inline <style>/style attributes; scripts have no such need.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Enable when TLS terminates at/above this nginx (harmless behind an
    # HTTPS-terminating LB since it only takes effect over HTTPS).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # API + auth routes proxied to the license API container so the load
    # balancer needs a single backend. Preserve client IP for rate limiting.
    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/auth/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health endpoints exposed for the load balancer:
    #   /readyz drains an instance whose DB connection is dead.
    location = /healthz { proxy_pass ${API_UPSTREAM}; }
    location = /readyz  { proxy_pass ${API_UPSTREAM}; }

    # SPA fallback for TanStack Router client-side routes.
    location / {
        try_files $uri /index.html;
    }

    # Long-cache fingerprinted assets; never cache HTML so deploys go live.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
