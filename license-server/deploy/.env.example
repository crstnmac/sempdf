# Production environment for the license server (docker-compose.prod.yml).
# Copy to .env on each instance. NEVER commit .env.
# Secrets marked [secret] belong in OVH Secret Manager; render them into .env
# at deploy time rather than storing them in the repo or an AMI.

# ── Image selection (used by compose itself) ────────────────────────────────
# OVH Managed Private Registry, e.g. abc123.gra7.container-registry.ovh.net/sempdf
REGISTRY=
TAG=latest

# ── Required secrets (api crashes at boot if missing) ───────────────────────
# OVH managed Postgres. TLS is enforced by OVH — keep sslmode=require.
# [secret]
DATABASE_URL=postgres://USER:PASS@HOST:20184/licensedb?sslmode=require
# Ed25519 private key for license signing (npm run keygen). [secret]
LICENSE_SIGNING_KEY=
# better-auth session secret, 32+ random bytes. [secret]
BETTER_AUTH_SECRET=

# ── Signing key rotation ─────────────────────────────────────────────────────
LICENSE_SIGNING_KID=v1
# Comma-separated previous public keys kept valid during rotation.
#LICENSE_SIGNING_PUBKEYS_PREV=

# ── Public URLs ──────────────────────────────────────────────────────────────
# Public HTTPS origin (the LB's floating IP DNS name).
APP_URL=https://license.example.com
BETTER_AUTH_URL=https://license.example.com
TRUSTED_ORIGINS=https://license.example.com

# ── SMTP (OVH blocks port 25 outbound — use 587 submission) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# [secret]
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=SemPDF
SUPPORT_EMAIL=

# ── Superadmin bootstrap (only read by create-superadmin one-off) ───────────
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
# [secret]
SUPERADMIN_PASSWORD=

# ── Observability (Loki + Prometheus on the monitoring server) ──────────────
# Base URLs of the monitoring server, reachable from the instances
# (private/vRack address preferred; use https + auth proxy if crossing public).
LOKI_ENDPOINT=http://10.0.0.20:3100
PROM_ENDPOINT=http://10.0.0.20:9090
# Per-host label so Grafana can tell the two instances apart (e.g. lic-1, lic-2).
HOST_TAG=

# ── Tuning ───────────────────────────────────────────────────────────────────
# DB1-4 allows ~100 connections minus reserved. 2 instances x pool + jobs:
# keep per-instance pool modest.
PG_POOL_MAX=15
HSTS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX=50
#DEFAULT_TRIAL_DAYS=14
#TELEMETRY_RETENTION_DAYS=90
#SWEEP_STALE_SECONDS=7200
