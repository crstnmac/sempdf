# Monitoring stack env — copy to .env next to this compose file on lic-1.

# Pin all listeners to the host's PRIVATE IP (lic-1: 10.0.0.4).
BIND_IP=10.0.0.4

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Alert email delivery — same SMTP account as the api instances. [secret]
SMTP_ENABLED=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=support@sempdf.net
SMTP_PASS=
SMTP_FROM=support@sempdf.net

# Where alert notifications go (alerting/contact-points.yaml).
ALERT_EMAIL=criston@sempdf.com
