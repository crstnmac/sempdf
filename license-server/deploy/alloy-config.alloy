// Grafana Alloy — runs on each instance, ships to the monitoring server.
//   logs:    tails all docker containers via the docker socket → Loki
//   metrics: scrapes the api's Prometheus /metrics → Prometheus remote-write
// Endpoints come from .env (LOKI_ENDPOINT / PROM_ENDPOINT), HOST_TAG labels
// every log line + metric with which instance it came from.

// ── Logs ─────────────────────────────────────────────────────────────────────

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // "/sempdf-api" → container="sempdf-api"
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "logs" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url = sys.env("LOKI_ENDPOINT") + "/loki/api/v1/push"
  }
  external_labels = {
    host      = sys.env("HOST_TAG"),
    namespace = "sempdf",
  }
}

// ── Metrics ──────────────────────────────────────────────────────────────────

prometheus.scrape "license_api" {
  job_name        = "license-api"
  scrape_interval = "30s"
  targets         = [{ __address__ = "api:8787" }]
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.remote_write "monitoring" {
  endpoint {
    url = sys.env("PROM_ENDPOINT") + "/api/v1/write"
  }
  external_labels = {
    host      = sys.env("HOST_TAG"),
    namespace = "sempdf",
  }
}
