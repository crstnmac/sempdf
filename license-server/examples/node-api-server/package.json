{
  "name": "pdf-api-server",
  "version": "0.1.0",
  "private": true,
  "description": "Node API generating accessible PDF reports with @zeropdf/zeropdf-pdf, licensed via the zero-config Node auto-guard.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@zeropdf/zeropdf-pdf": "^2.1.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
