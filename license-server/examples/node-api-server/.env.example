# Copy to .env and fill in your license key (customer portal -> API keys).
# Zero-config auto-guard: setting these two is the only licensing setup
# needed in Node — no client package, no manual checkout/flush calls.
SEMPDF_LICENSE_KEY=
SEMPDF_LICENSE_SERVER=https://sempdf.sempdf.net

PORT=3001

# --- S3 upload (POST /api/reports/s3) --------------------------------------
# Credentials resolve via the default AWS SDK chain; set these two only for
# local testing (in production, use an instance/task IAM role instead).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket must block all public access — the presigned URL is the only path in.
S3_BUCKET=
# How long the presigned download URL stays valid.
S3_PRESIGN_EXPIRY_SECONDS=900
