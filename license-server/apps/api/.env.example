# Postgres connection used by both Drizzle (app tables) and better-auth.
DATABASE_URL=postgres://user:pass@localhost:5432/zeropdf_license

# Ed25519 private key (PKCS8 PEM) for signing authorize responses.
# Generate with: npm run keygen
LICENSE_SIGNING_KEY=""

# better-auth
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-a-long-random-string

PORT=8787
PG_POOL_MAX=10

# Public URL of the customer portal/dashboard — used in email links (sign-in, billing).
APP_URL=http://localhost:3000

# SMTP — transactional + lifecycle emails (welcome, usage alerts, renewal/trial reminders).
# Leave SMTP_HOST empty to run without a mail server: emails are logged, not sent.
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
# true for implicit TLS (port 465); leave false for STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=user@gmail.com
SMTP_PASS=password
SMTP_FROM=no-reply@zeropdf.com
SMTP_FROM_NAME=ZeroPDF
PRODUCT_NAME=ZeroPDF
SUPPORT_EMAIL=support@zeropdf.com

# Default trial length (days) when none is specified on customer creation.
DEFAULT_TRIAL_DAYS=15
