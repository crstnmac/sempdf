# Postgres connection used by both Drizzle (app tables) and better-auth.
DATABASE_URL=postgres://user:pass@localhost:5432/a11ydocs_license

# Ed25519 private key (PKCS8 PEM) for signing authorize responses.
# Generate with: npm run keygen
LICENSE_SIGNING_KEY=""

# better-auth
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-a-long-random-string

PORT=8787
PG_POOL_MAX=10
