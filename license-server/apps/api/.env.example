# =============================================================================
# SECRETS (no safe default — the server fails fast at startup if any is missing).
# PRODUCTION: inject these via the platform's secret store (e.g. the cloud
# provider's secret manager / env injection), NEVER a committed .env file. This
# file is an example only; do not put real secrets here.
# =============================================================================

# Postgres connection used by both Drizzle (app tables) and better-auth.  [SECRET]
DATABASE_URL=postgres://user:pass@localhost:5432/sempdf_license

# Ed25519 private key (PKCS8 PEM) for signing authorize responses.  [SECRET]
# Generate with: npm run keygen
LICENSE_SIGNING_KEY=""

# better-auth session/cookie secret — long random string.  [SECRET]
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# =============================================================================
# Signing key rotation
# =============================================================================

# Stable id (`kid`) advertised with each signed authorize response and in
# /v1/public-key, so clients can select the right public key. Default "v1".
LICENSE_SIGNING_KID=v1

# Optional verification-only PREVIOUS public keys for a rotation window.
# Comma-separated `kid:base64(spkiPem)` entries. Clients keep verifying old
# responses (which carry the old kid) until the rollover completes. Leave empty
# when not rotating.
# LICENSE_SIGNING_PUBKEYS_PREV=v0:LS0tLS1CRUdJTi...

# =============================================================================
# Server
# =============================================================================

BETTER_AUTH_URL=http://localhost:8787
PORT=8787

# Browser origins allowed to call /v1/admin/* and /v1/portal/* (CORS, credentialed)
# and trusted by better-auth. Comma-separated.
TRUSTED_ORIGINS=http://localhost:3000

# Public URL of the customer portal/dashboard — used in email links (sign-in, billing).
APP_URL=http://localhost:3000

# Enable HSTS header. Only meaningful when TLS terminates upstream — leave false
# for plain-HTTP local dev.
HSTS_ENABLED=false

# =============================================================================
# Postgres pool / timeouts
# =============================================================================

PG_POOL_MAX=10
# Acquire timeout: how long a request waits for a free pooled connection (ms).
PG_CONNECTION_TIMEOUT_MS=5000
# Per-session statement_timeout (ms): a stuck query is aborted, not left holding
# a connection forever.
PG_STATEMENT_TIMEOUT_MS=10000

# =============================================================================
# Request guards (machine routes /v1/*)
# =============================================================================

# Max JSON body size in bytes; over → 413.
MAX_BODY_BYTES=65536
# Per-request timeout in ms; over → 504.
REQUEST_TIMEOUT_MS=15000
# Max units a single /v1/authorize call may charge; over → 400 bad_request.
MAX_REQUESTED_PER_CALL=10000

# =============================================================================
# Rate limiting (machine routes; in-memory, PER-INSTANCE — see infra doc)
# =============================================================================

RATE_LIMIT_ENABLED=false
# Sliding-window length (ms) and max requests per (api-key + client IP).
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX=50

# =============================================================================
# Retention (run `npm run telemetry:prune:prod` daily from cron)
# =============================================================================

# Delete raw api_telemetry rows older than this many days.
TELEMETRY_RETENTION_DAYS=90
# Delete request_nonces (idempotency ledger) older than this many days.
NONCE_RETENTION_DAYS=7
# Batched-delete tuning.
PRUNE_BATCH_SIZE=10000
PRUNE_BATCH_PAUSE_MS=200

# =============================================================================
# Sweep freshness (alerting)
# =============================================================================

# Seconds after which the notification sweep is considered stale (surfaced by
# /readyz and /metrics). The sweep is expected hourly; 0 disables the check.
SWEEP_STALE_SECONDS=7200

# =============================================================================
# SMTP — transactional + lifecycle emails (welcome, usage alerts, reminders).
# Leave SMTP_HOST empty to run without a mail server: emails are logged, not sent.
# SMTP_PASS is a [SECRET] in production.
# =============================================================================

SMTP_HOST=0.0.0.0
SMTP_PORT=2525
# true for implicit TLS (port 465); leave false for STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=user@gmail.com
SMTP_PASS=password
SMTP_FROM=no-reply@sempdf.com
SMTP_FROM_NAME=SemPDF
PRODUCT_NAME=SemPDF
SUPPORT_EMAIL=support@sempdf.com

# Default trial length (days) when none is specified on customer creation.
DEFAULT_TRIAL_DAYS=15
