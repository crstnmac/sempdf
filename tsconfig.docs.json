{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/components/**/*.tsx",
    "src/lib/layout.shared.tsx",
    "src/lib/shared.ts",
    "src/lib/source.ts",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx",
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "src/start.ts",
    "vite.config.ts"
  ]
}
